<%- include("partials/header") %>
<div class="flex flex-row justify-between my-4">
    <h1 class="text-4xl font-bold">Home</h1>
    <a href="/compose" class="p-2 text-white bg-emerald-500 rounded-md">COMPOSE</a>
</div>
<%= homeStartingContent %>
<% if(posts && posts.length > 0) { %>
<h1 class="text-2xl my-4 font-semibold">Recent Posts</h1>
<div class="flex flex-col gap-y-4 m-2">
    <% posts.forEach((post) => {%>
    <div class="post flex flex-col gap-y-2 post p-4 border-2 border-gray-200 rounded-lg">
        <h2 class="font-semibold"><%= post.title %></h2>
        <p><%= post.body.slice(0, 297) %><%= post.body.length > 300 ? "..." : "" %></p>
        <div class="flex flex-row gap-x-2 items-center">
            <!-- I think Read More should still present even if the post is less than 300 characters -->
            <a class="text-emerald-400" href="/post/<%= post.title %>">Read more</a>
            <button id="likes-<%= post.id %>" class="like-btn px-2 py-1 bg-emerald-500 disabled:bg-emerald-500/50 rounded-md text-white cursor-pointer" data-id="<%= post.id %>">Likes: <%= post.likes %></button>
            <p id="status-<%= post.id %>" class="status text-sm text-red-500"></p>
        </div>
    </div>
    <% }) %>
</div>
<% } %>
<%- include("partials/footer") %>
<script type="application/javascript" src="like.js"></script>