<div class="post-card group relative bg-white dark:bg-slate-800 rounded-xl sm:rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden hover:border-blue-300 dark:hover:border-blue-600 transition-all duration-300 hover:shadow-xl dark:hover:shadow-blue-900/50 hover:-translate-y-2 cursor-pointer animate-fadeInUp" style="animation-delay: <%= index * 100 %>ms" data-blog-id="<%= post.blogid %>" data-blog-slug="<%= post.title.toLowerCase().replace(/\s+/g, "-") %>">
                        
    <!-- Card accent bar -->
    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-400 via-indigo-400 to-blue-400"></div>
    
    <!-- Content -->
    <div class="p-5 sm:p-6 flex flex-col h-full">
        <!-- Tag -->
        <div class="mb-3">
            <span class="inline-block px-2.5 sm:px-3 py-1 text-xs font-semibold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 rounded-full"><%= req.t('posts.featured') %></span>
        </div>
        
        <!-- Title -->
        <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white mb-3 line-clamp-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-300">
            <%= post.title %>
        </h3>
        
        <!-- Preview -->
        <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4 line-clamp-3 flex-grow">
            <%= post.description ? post.description : req.t('posts.no_description') %>
        </p>
        
        <!-- Footer with interaction -->
        <div class="flex items-center justify-between pt-4 border-t border-slate-100 dark:border-slate-700 gap-2">
            <a class="text-sm font-semibold text-blue-500 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors duration-300 flex items-center gap-1 flex-1" href="/blogs/<%= post.blogid %>/<%= post.title.toLowerCase().replace(/\s+/g, "-") %>">
                <%= req.t('posts.read_more') %>
                <i class="mdi mdi-arrow-right group-hover:translate-x-1 transition-transform duration-300"></i>
            </a>
            <div id="likes-<%= post.blogid %>" class="flex items-center gap-1 px-2 py-1.5 text-sm font-medium text-slate-600 dark:text-slate-400 rounded-lg whitespace-nowrap" data-id="<%= post.blogid %>">
                <i class="mdi mdi-heart text-base"></i>
                <span id="likes-count-<%= post.blogid %>" class="text-xs sm:text-sm"><%= post.likes %></span>
            </div>
            <div class="flex items-center gap-1 px-2 py-1.5 text-sm font-medium text-slate-600 dark:text-slate-400 rounded-lg whitespace-nowrap">
                <i class="mdi mdi-comment text-base"></i>
                <span class="text-xs sm:text-sm"><%= cc %></span>
            </div>
            <p id="status-<%= post.blogid %>" class="status text-xs text-red-500 h-4"></p>
        </div>
    </div>
</div>
