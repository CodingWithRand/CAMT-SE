<div class="post-list-item group bg-white dark:bg-slate-800 rounded-lg sm:rounded-xl border border-slate-200 dark:border-slate-700 p-4 sm:p-5 hover:border-indigo-300 dark:hover:border-indigo-600 hover:shadow-md dark:hover:shadow-indigo-900/50 transition-all duration-300 hover:bg-slate-50 dark:hover:bg-slate-700 animate-fadeInUp" style="animation-delay: <%= index * 100 %>ms">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-4">
        <div class="flex-grow min-w-0">
            <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white mb-1.5 line-clamp-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-300">
                <%= post.title %>
            </h3>
            <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm line-clamp-2">
                <%= post.description ? post.description : req.t('posts.no_description') %>
            </p>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
            <a class="px-2 py-1.5 text-xs sm:text-sm font-medium text-indigo-500 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors duration-300 whitespace-nowrap" href="/blogs/<%= post.blogid %>/<%= post.title.toLowerCase().replace(/\s+/g, "-") %>">
                <%= req.t('posts.read') %>
            </a>
            <button id="likes-<%= post.blogid %>" class="flex items-center gap-1 px-2 py-1.5 text-xs sm:text-sm text-slate-600 dark:text-slate-400 rounded transition-all duration-300" data-id="<%= post.blogid %>">
                <i class="mdi mdi-heart text-base"></i>
                <span id="likes-count-<%= post.blogid %>"><%= post.likes %></span>
            </button>
            <div class="flex items-center gap-1 px-2 py-1.5 text-sm text-slate-600 dark:text-slate-400 rounded-lg whitespace-nowrap">
                <i class="mdi mdi-comment text-base"></i>
                <span class="text-xs sm:text-sm"><%= cc %><span class="block w-<%= 4 + (2 * (Math.floor(maxCC/10) - Math.floor(cc/10) - 1)) %>"></span></span>
            </div>
        </div>
    </div>
</div>