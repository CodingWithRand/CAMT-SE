<%- include("../../partials/header", { pageTitle: "Account Settings - Whiskey" }) %>

<%

function isURL(str) {
    try {
        new URL(str);
        return true;
    } catch (_) {
        return false;
    }
}

%>

<section class="relative pt-20 sm:pt-24 pb-16 sm:pb-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950">
    <div class="mx-auto max-w-4xl">
        <div class="text-center mb-12 sm:mb-16 animate-fadeInDown">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold bg-gradient-to-r from-slate-900 via-blue-800 to-slate-900 dark:from-white dark:via-blue-300 dark:to-white bg-clip-text text-transparent mb-6 leading-tight flex items-center justify-center gap-3">
                <i class="mdi mdi-lock text-4xl sm:text-5xl lg:text-6xl"></i>Account Settings
            </h1>
            <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
                Manage your account security and personal information
            </p>
        </div>
    </div>
</section>

<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <!-- Settings Sections Grid -->
    <div class="space-y-8">
        
        <!-- Profile Information -->
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 sm:p-8 shadow-sm dark:shadow-slate-950 animate-fadeInUp">
            <div class="flex items-center gap-3 mb-6">
                <i class="mdi mdi-account text-4xl text-slate-900 dark:text-white"></i>
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Profile Information</h2>
            </div>
            
            <form id="account-profile-form" class="space-y-6">
                <!-- Avatar -->
                <div>
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-3">Profile Picture</label>
                    <div class="flex items-center gap-6">
                        <% if(isURL(user?.avatar)) { %>
                            <img class="pfp w-24 h-24 rounded-full bg-white " src="<%= user?.avatar %>" alt="User Avatar">
                        <% } else { %>
                            <div class="pfp w-24 h-24 rounded-full bg-gradient-to-br <%= user?.avatar %> flex items-center justify-center text-white text-2xl font-bold">
                                <%= user?.username.charAt(0).toUpperCase() || "U" %>
                            </div>
                        <% } %>
                        <div>
                            <input type="file" id="avatar-input" class="hidden" accept="image/*" />
                            <button type="button" onclick="document.getElementById('avatar-input').click()" class="px-4 py-2 bg-blue-500 dark:bg-blue-600 text-white rounded-lg hover:bg-blue-600 dark:hover:bg-blue-700 transition-all duration-300 text-sm font-medium">
                                Change Picture
                            </button>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">JPG, PNG or GIF. Max 10MB</p>
                        </div>
                    </div>
                </div>

                <!-- Display Name -->
                <div>
                    <div class="flex justify-between items-center">
                        <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2">Display Name</label>
                        <span class="text-xs text-slate-500 mb-2">3-30 characters.</span>
                    </div>
                    <input 
                        type="text" 
                        name="display-name"
                        placeholder="John Doe" 
                        class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-900 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500"
                        value="<%= user.display_name %>"
                    />
                </div>

                <!-- Username -->
                <div>
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2">Username</label>
                    <div class="relative">
                        <span class="absolute left-4 top-3.5 text-slate-600 text-sm">@</span>
                        <input 
                            type="text" 
                            name="username"
                            placeholder="johndoe" 
                            class="w-full pl-8 pr-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-400 cursor-not-allowed"
                            value="<%= user.username %>"
                            disabled
                        />
                    </div>
                </div>

                <!-- Bio -->
                <div>
                    <div class="flex justify-between items-center">
                        <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2">Bio</label>
                        <span class="text-xs text-slate-500 dark:text-slate-400 mb-2">Max 1000 characters. Characters Left: <%= 1000 - user.bio.length %></span>
                    </div>
                    <textarea 
                        name="bio"
                        placeholder="Tell us about yourself..." 
                        class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-900 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 resize-none"
                        rows="5"
                    ><%= user.bio %></textarea>
                </div>

                <!-- Website URL -->
                <!-- <div>
                    <label class="block text-sm font-semibold text-slate-900 mb-2">Personal Website</label>
                    <input 
                        type="url" 
                        name="website"
                        placeholder="https://yourwebsite.com" 
                        class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 focus:outline-none transition-all duration-300 bg-white text-slate-900 placeholder-slate-400"
                    />
                </div> -->

                <!-- 
                TODO: 
                - Add banner image 
                - Other info, e.g. social media.
                -->

                <div class="flex gap-3 pt-4 border-t border-slate-200 dark:border-slate-700">
                    <button type="submit" class="px-6 py-2 bg-gradient-to-r from-blue-500 to-blue-600 dark:from-blue-600 dark:to-blue-700 text-white font-semibold rounded-lg hover:shadow-lg dark:hover:shadow-blue-900/50 transition-all duration-300 text-sm flex items-center gap-2">
                        <i class="mdi mdi-check"></i>Save Profile
                    </button>
                </div>
            </form>
        </div>

        <!-- Email & Verification -->
        <!-- TODO: (After MVP), email verification -->
        <!-- <div class="bg-white rounded-xl border border-slate-200 p-6 sm:p-8 shadow-sm animate-fadeInUp" style="animation-delay: 100ms;">
