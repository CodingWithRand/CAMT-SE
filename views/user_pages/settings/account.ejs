        <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 sm:p-8 shadow-sm dark:shadow-slate-950 animate-fadeInUp" style="animation-delay: 200ms;">
            <div class="flex items-center gap-3 mb-6">
                <i class="mdi mdi-key text-4xl dark:text-white"></i>
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white"><%= req.t("account_settings.password_security") %></h2>
            </div>
            
            <form class="space-y-6" id="password-form">
                <div>
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2"><%= req.t("account_settings.current_password_label") %></label>
                    <input 
                        type="password" 
                        name="current-password"
                        placeholder="<%= req.t("account_settings.current_password_placeholder") %>" 
                        class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-900 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500"
                    />
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-2"><%= req.t("account_settings.current_password_hint") %></p>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2"><%= req.t("account_settings.new_password_label") %></label>
                    <input 
                        type="password" 
                        name="new-password"
                        id="new-password"
                        placeholder="<%= req.t("account_settings.new_password_placeholder") %>" 
                        class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-900 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500"
                    />
                </div>  

                <div class="bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-lg p-4 space-y-2">
                    <p class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-3"><%= req.t("account_settings.password_requirements_title") %></p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <div class="flex items-center gap-2 text-xs">
                            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-300 dark:bg-red-700 text-red-600 dark:text-red-200" id="length-icon">✗</span>
                            <span id="length-text" class="text-red-600 dark:text-red-400"><%= req.t("account_settings.req_length") %></span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-300 dark:bg-red-700 text-red-600 dark:text-red-200" id="uppercase-icon">✗</span>
                            <span id="uppercase-text" class="text-red-600 dark:text-red-400"><%= req.t("account_settings.req_uppercase") %></span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-300 dark:bg-red-700 text-red-600 dark:text-red-200" id="number-icon">✗</span>
                            <span id="number-text" class="text-red-600 dark:text-red-400"><%= req.t("account_settings.req_number") %></span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-300 dark:bg-red-700 text-red-600 dark:text-red-200" id="special-icon">✗</span>
                            <span id="special-text" class="text-red-600 dark:text-red-400"><%= req.t("account_settings.req_special") %></span>
                        </div>
                    </div>
                </div>   

                <div>
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2"><%= req.t("account_settings.confirm_new_password_label") %></label>
                    <input 
                        type="password" 
                        name="confirm-password"
                        placeholder="<%= req.t("account_settings.confirm_new_password_placeholder") %>" 
                        class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-900 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500"
                    />
                </div>

                <div class="flex-col custom-500:flex-row flex justify-between items-center gap-3 pt-4 border-t border-slate-200 dark:border-slate-700">
                    <button type="submit" class="px-6 py-2 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-blue-500/50 transition-all duration-300 text-sm flex items-center gap-2">
                        <i class="mdi mdi-refresh"></i><%= req.t("account_settings.update_password_btn") %>
                    </button>
                    <div class="text-slate-400 dark:text-slate-500">
                        <%= req.t("account_settings.forgot_password_txt") %>
                        <button id="forget-password" class="text-base sm:text-md text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium"><%= req.t("account_settings.reset_here_btn") %></button>
                    </div>
                </div>
            </form>
        </div>

