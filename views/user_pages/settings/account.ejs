        <div class="bg-red-50 dark:bg-red-950/20 rounded-xl border-2 border-red-200 dark:border-red-900/50 p-6 sm:p-8 shadow-sm dark:shadow-red-950/50 animate-fadeInUp" style="animation-delay: 500ms;">
            <div class="flex items-center gap-3 mb-6">
                <i class="mdi mdi-alert text-3xl text-red-700 dark:text-red-400"></i>
                <h2 class="text-2xl font-bold text-red-700 dark:text-red-400"><%= req.t("account_settings.danger_zone_title") %></h2>
            </div>
            
            <div class="space-y-4">
                <div class="p-4 rounded-lg bg-white dark:bg-slate-900 border border-red-200 dark:border-red-900/50">
                    <p class="text-sm font-medium text-slate-900 dark:text-white mb-2"><%= req.t("account_settings.delete_account_title") %></p>
                    <p class="text-xs text-slate-600 dark:text-slate-400 mb-4">
                        <%= req.t("account_settings.delete_account_desc") %>
                    </p>
                    <button type="button" id="account-delete" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-all duration-300 text-sm font-medium">
                        <%= req.t("account_settings.delete_account_btn") %>
                    </button>
                </div>
            </div>
        </div>

        <div class="flex justify-center gap-3 pt-6 animate-fadeInUp" style="animation-delay: 600ms;">
            <a href="/" class="px-8 py-3 border-2 border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-semibold rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 transition-all duration-300">
                <%= req.t("account_settings.back_to_feed_btn") %>
            </a>
        </div>
    </div>
    <div id="password-reset-modal" class="hidden fixed inset-0 top-[4.5rem] h-[calc(100%-4.5rem)] bg-black/50 flex items-center justify-center px-4 z-50 animate-fadeIn">
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6 shadow-lg dark:shadow-slate-950 w-full max-w-md sm:max-w-lg">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white"><%= req.t("account_settings.reset_password_modal_title") %></h2>
                <button class="close-reset-modal text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 text-2xl transition-colors">
                    <i class="mdi mdi-close text-2xl"></i>
                </button>
            </div>

            <p class="text-slate-600 dark:text-slate-400 mb-6"><%= req.t("account_settings.reset_password_modal_desc") %></p>

            <form id="password-reset-form" class="space-y-5">
                <div>
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2"><%= req.t("account_settings.email_address_label") %></label>
                    <input 
                        type="email" 
                        id="reset-email" 
                        placeholder="you@example.com" 
                        class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500"
                    />
                </div>

                <button type="submit" class="w-full px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 dark:from-blue-600 dark:to-blue-700 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-blue-500/50 dark:hover:shadow-blue-900/50 transition-all duration-300">
                    <%= req.t("account_settings.send_reset_link_btn") %>
                </button>
            </form>

            <div id="reset-success-message" class="hidden mt-6 p-4 bg-green-50 dark:bg-green-950/20 border border-green-200 dark:border-green-900/50 rounded-lg text-center">
                <p class="text-green-700 dark:text-green-400 font-semibold"><%= req.t("account_settings.reset_success_title") %></p>
                <p class="text-green-600 dark:text-green-400 text-sm mt-1"><%= req.t("account_settings.reset_success_desc") %></p>
            </div>
        </div>
    </div>

    <div id="account-delete-modal" class="hidden fixed inset-0 top-[4.5rem] h-[calc(100%-4.5rem)] bg-black/50 flex items-center justify-center px-4 z-50 animate-fadeIn">
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6 shadow-lg dark:shadow-slate-950 w-full max-w-md sm:max-w-lg">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white"><%= req.t("account_settings.delete_account_modal_title") %></h2>
                <button class="close-reset-modal text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 text-2xl transition-colors">
                    <i class="mdi mdi-close text-2xl"></i>
                </button>
            </div>

            <p class="text-slate-600 dark:text-slate-400 mb-6"><%= req.t("account_settings.delete_account_modal_desc") %></p>

            <form id="account-delete-form" class="space-y-5">
                <div>
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2"><%= req.t("account_settings.your_password_label") %></label>
                    <input 
                        type="password" 
                        id="account-delete-confirm-password" 
                        class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500"
                    />
                </div>

                <button type="submit" class="w-full px-6 py-3 bg-gradient-to-r from-red-500 to-red-600 dark:from-red-600 dark:to-red-700 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-red-500/50 dark:hover:shadow-red-900/50 transition-all duration-300">
                    <%= req.t("account_settings.submit_delete_account_btn") %>
                </button>
            </form>
        </div>
    </div>
</div>

