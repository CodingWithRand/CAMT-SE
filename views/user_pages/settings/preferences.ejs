<section class="relative pt-20 sm:pt-24 pb-16 sm:pb-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950">
    <div class="mx-auto max-w-4xl">
        <div class="text-center mb-12 sm:mb-16 animate-fadeInDown">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold bg-gradient-to-r from-slate-900 via-blue-800 to-slate-900 dark:from-white dark:via-blue-300 dark:to-white bg-clip-text text-transparent mb-6 leading-tight flex items-center justify-center gap-3 transition-all duration-300">
                <i class="mdi mdi-cog text-4xl sm:text-5xl lg:text-6xl"></i>Preferences
            </h1>
            <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
                Customize your reading and writing experience
            </p>
        </div>
    </div>
</section>

<% preferences = preferences[0] %>

<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <!-- Settings Sections Grid -->
    <form id="preference-settings" class="space-y-8">
        
        <!-- Theme Customization -->
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 sm:p-8 shadow-sm dark:shadow-slate-950 animate-fadeInUp transition-all duration-300">
            <div class="flex items-center gap-3 mb-6">
                <i class="mdi mdi-palette text-4xl text-slate-900 dark:text-white"></i>
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white transition-all duration-300">Theme & Appearance</h2>
            </div>
            
            <div class="space-y-6">
                <!-- Light/Dark/Auto Mode -->
                <div>
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-3 transition-all duration-300">Display Mode</label>
                    <div class="flex flex-wrap gap-3">
                        <label class="flex items-center gap-2 px-3 py-2 rounded-lg border-2 border-slate-200 dark:border-slate-600 hover:border-blue-500 dark:hover:border-blue-400 cursor-pointer transition-all duration-300 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 dark:has-[:checked]:bg-slate-700 dark:has-[:checked]:border-blue-400">
                            <input type="radio" name="theme-mode" value="light" class="hidden w-4 h-4 text-blue-600" <%= preferences?.theme === 'light' ? 'checked' : '' %> />
                            <span class="text-sm font-medium flex items-center gap-1 text-slate-900 dark:text-slate-200 transition-all duration-300"><i class="mdi text-lg mdi-white-balance-sunny"></i> Light</span>
                        </label>
                        <label class="flex items-center gap-2 px-3 py-2 rounded-lg border-2 border-slate-200 dark:border-slate-600 hover:border-blue-500 dark:hover:border-blue-400 cursor-pointer transition-all duration-300 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 dark:has-[:checked]:bg-slate-700 dark:has-[:checked]:border-blue-400">
                            <input type="radio" name="theme-mode" value="dark" class="hidden w-4 h-4 text-blue-600" <%= preferences?.theme === 'dark' ? 'checked' : '' %> />
                            <span class="text-sm font-medium flex items-center gap-1 text-slate-900 dark:text-slate-200 transition-all duration-300"><i class="mdi text-lg mdi-moon-waning-crescent"></i> Dark</span>
                        </label>
                        <label class="flex items-center gap-2 px-3 py-2 rounded-lg border-2 border-slate-200 dark:border-slate-600 hover:border-blue-500 dark:hover:border-blue-400 cursor-pointer transition-all duration-300 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 dark:has-[:checked]:bg-slate-700 dark:has-[:checked]:border-blue-400">
                            <input type="radio" name="theme-mode" value="auto" class="hidden w-4 h-4 text-blue-600" <%= preferences?.theme === 'auto' ? 'checked' : '' %> />
                            <span class="text-sm font-medium flex items-center gap-1 text-slate-900 dark:text-slate-200 transition-all duration-300"><i class="mdi text-lg mdi-refresh"></i> Auto</span>
                        </label>
                    </div>
                </div>
                <!-- Language -->
                <div>
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-3 transition-all duration-300">Language</label>
                    <div class="flex flex-wrap gap-3">
                        <label class="flex items-center gap-2 px-3 py-2 rounded-lg border-2 border-slate-200 dark:border-slate-600 hover:border-blue-500 dark:hover:border-blue-400 cursor-pointer transition-all duration-300 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 dark:has-[:checked]:bg-slate-700 dark:has-[:checked]:border-blue-400">
                            <input type="radio" name="lang" value="th" class="hidden w-4 h-4 text-blue-600" <%= preferences?.lang === 'th' ? 'checked' : '' %> />
                            <span class="text-sm font-medium flex items-center gap-1 text-slate-900 dark:text-slate-200 transition-all duration-300">TH Thai</span>
                        </label>
                        <label class="flex items-center gap-2 px-3 py-2 rounded-lg border-2 border-slate-200 dark:border-slate-600 hover:border-blue-500 dark:hover:border-blue-400 cursor-pointer transition-all duration-300 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 dark:has-[:checked]:bg-slate-700 dark:has-[:checked]:border-blue-400">
                            <input type="radio" name="lang" value="en" class="hidden w-4 h-4 text-blue-600" <%= preferences?.lang === 'en' ? 'checked' : '' %> />
                            <span class="text-sm font-medium flex items-center gap-1 text-slate-900 dark:text-slate-200 transition-all duration-300">EN English</span>
                        </label>
                    </div>
                </div>
                
                <!-- Accent Color (After MVP) -->
                <!-- <div>
                    <label class="block text-sm font-semibold dark:text-white text-slate-900 mb-3">Accent Color</label>
