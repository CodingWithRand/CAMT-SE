                <i class="mdi mdi-note-text text-4xl text-slate-900 dark:text-white"></i>
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white transition-all duration-300">Typography</h2>
            </div>
            
            <div class="space-y-6">
                <!-- Font Family -->
                <div>
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-3 transition-all duration-300">Font Family</label>
                    <select name="font-family" class="w-full sm:w-64 px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-900 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white">
                        <!-- <option value="system">System Default</option> -->
                        <option value="sans" class="font-sans" <%= preferences?.font_family === 'sans' ? 'selected' : '' %>>Modern Sans (default)</option>
                        <option value="serif" class="font-serif" <%= preferences?.font_family === 'serif' ? 'selected' : '' %>>Classic Serif</option>
                        <option value="mono" class="font-mono" <%= preferences?.font_family === 'mono' ? 'selected' : '' %>>Monospace (Code)</option>
                        <!-- <option value="rounded">Rounded & Friendly</option> -->
                    </select>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 transition-all duration-300">Choose the font style for your reading experience</p>
                </div>

                <!-- Base Font Size -->
                <div>
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-3 transition-all duration-300">Base Font Size</label>
                    <div class="flex items-center gap-4">
                        <input type="range" name="font-size" min="12" max="20" value="<%= preferences?.font_size || 16 %>" class="w-full sm:w-64 h-2 bg-slate-200 dark:bg-slate-600 rounded-lg appearance-none cursor-pointer accent-blue-500 transition-all duration-300" />
                        <span id="font-size-display" class="text-sm font-medium text-slate-900 dark:text-white min-w-fit transition-all duration-300"><%= preferences?.font_size || 16 %>px</span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 transition-all duration-300">Adjust the default text size for better readability</p>
                </div>

                <!-- Line Spacing (after mvp) -->
