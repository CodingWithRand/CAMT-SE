        <!-- Privacy & Sharing -->
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 sm:p-8 shadow-sm dark:shadow-slate-950 animate-fadeInUp transition-all duration-300" style="animation-delay: 300ms;">
            <div class="flex items-center gap-3 mb-6">
                <i class="mdi mdi-lock text-3xl text-slate-900 dark:text-white"></i>
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white transition-all duration-300">Privacy & Sharing</h2>
            </div>
            
            <div class="space-y-4">
                <!-- Profile Visibility -->
                <label class="flex items-center justify-between p-4 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 cursor-pointer transition-all duration-300">
