<%- include("../partials/header", { pageTitle: null }) %>

<%

function isURL(str) {
    try {
        new URL(str);
        return true;
    } catch (_) {
        return false;
    }
}

function getTimeAgo(stamp) {
    const now = new Date().getTime();
    const publishedDate = new Date(stamp).getTime();
    const diffInSeconds = Math.floor((now - publishedDate) / 1000);
    if (diffInSeconds < 60) {
        return diffInSeconds + ` ${req.t('getTimeAgo.second')}${diffInSeconds === 1 ? '' : req.t('getTimeAgo.englishPlural')}${req.t('getTimeAgo.punctuation')}${req.t('getTimeAgo.ago')}`;
    } else if (diffInSeconds < (60 * 60)) {
        const minutes = Math.floor(diffInSeconds / (60));
        return minutes + ` ${req.t('getTimeAgo.minute')}${minutes === 1 ? '' : req.t('getTimeAgo.englishPlural')}${req.t('getTimeAgo.punctuation')}${req.t('getTimeAgo.ago')}`;
    } else if (diffInSeconds < (60 * 60 * 24)) {
        const hours = Math.floor(diffInSeconds / (60 * 60));
        return hours + ` ${req.t('getTimeAgo.hour')}${hours === 1 ? '' : req.t('getTimeAgo.englishPlural')}${req.t('getTimeAgo.punctuation')}${req.t('getTimeAgo.ago')}`;
    } else if (diffInSeconds < (60 * 60 * 24 * 30)) {
        const days = Math.floor(diffInSeconds / (60 * 60 * 24));
        return days + ` ${req.t('getTimeAgo.day')}${days === 1 ? '' : req.t('getTimeAgo.englishPlural')}${req.t('getTimeAgo.punctuation')}${req.t('getTimeAgo.ago')}`;
    } else if (diffInSeconds < (60 * 60 * 24 * 30 * 12)) {
        const months = Math.floor(diffInSeconds / (60 * 60 * 24 * 30));
        return months + ` ${req.t('getTimeAgo.month')}${months === 1 ? '' : req.t('getTimeAgo.englishPlural')}${req.t('getTimeAgo.punctuation')}${req.t('getTimeAgo.ago')}`;
    } else {
        const years = Math.floor(diffInSeconds / (60 * 60 * 24 * 30 * 12));
        return years + ` ${req.t('getTimeAgo.year')}${years === 1 ? '' : req.t('getTimeAgo.englishPlural')}${req.t('getTimeAgo.punctuation')}${req.t('getTimeAgo.ago')}`;
    }
}

%>

<link rel="stylesheet" href="/css/home.css">

<!-- Saved Posts Container -->
<div class="flex flex-col lg:flex-row min-h-screen bg-gradient-to-b from-slate-50 via-slate-50 to-blue-50 dark:from-slate-950 dark:via-slate-900 dark:to-slate-900">
    
    <%- include("../partials/sidebar", { selected: "saved-posts" }) %>

    <!-- Main Content -->
    <main class="flex-1 pt-20 sm:pt-24 pb-12 px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl">
            
            <!-- Saved Posts Header Section -->
            <section class="mb-12">
                <div class="flex items-center gap-3 mb-2">
                    <i class="mdi mdi-bookmark text-4xl text-blue-600 dark:text-blue-400"></i>
                    <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white">Saved Posts</h1>
                </div>
                <p class="text-slate-600 dark:text-slate-400 text-lg">Your collection of bookmarked posts</p>
            </section>

            <!-- Posts Section -->
            <section class="mb-12">
                <% if(savedPosts.length === 0) { %>
                    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-8 sm:p-12 text-center">
                        <div class="flex flex-col items-center gap-4">
                            <i class="mdi mdi-bookmark-outline text-5xl text-slate-300 dark:text-slate-700"></i>
                            <div>
                                <p class="text-slate-700 dark:text-slate-300 font-semibold text-lg mb-2">No saved posts yet</p>
                                <p class="text-slate-600 dark:text-slate-400 mb-6">Bookmark posts to read them later</p>
                                <a href="/" class="inline-block px-6 py-2 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-blue-500/50 transition-all duration-300">
                                    Explore Posts
                                </a>
                            </div>
                        </div>
                    </div>
                <% } else { %>
                    <div id="blogs-container" class="space-y-6">
                        <% savedPosts.forEach((item, index) => { %>
                            <%- include("../partials/saves/postcard-v2", { blog: item, author: authors[index], cc: commentCounts[index] }) %>
                        <% }) %>
                    </div>
                <% } %>
            </section>

            <!-- Load More Button -->
            <div class="mt-8 text-center opacity-0 pointer-events-none">
                <button id="load-blog" class="px-8 py-3 border-2 border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 font-semibold rounded-lg hover:border-blue-500 dark:hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50 dark:hover:bg-slate-900 transition-all duration-300">
                    Load More Posts
                </button>
            </div>
        </div>
    </main>

    <!-- Mobile Sidebar Menu Button -->
    <div class="lg:hidden fixed bottom-6 left-6 z-80">
        <button id="mobile-menu-btn" class="w-14 h-14 rounded-full bg-gradient-to-r from-blue-500 to-blue-600 dark:from-blue-600 dark:to-blue-700 text-white shadow-lg dark:shadow-blue-900/50 hover:shadow-xl dark:hover:shadow-blue-800/50 transition-all duration-300 flex items-center justify-center">
            <i class="mdi mdi-menu text-2xl"></i>
        </button>
    </div>
</div>

<%- include("../partials/footer") %>
