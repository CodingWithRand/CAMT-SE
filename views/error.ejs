
<%
// Error configuration with default and custom mappings
const ec = typeof errorCode !== 'undefined' ? errorCode : 404;
const cm = typeof customMessage !== 'undefined' ? customMessage : null;
const ct = typeof customTip !== 'undefined' ? customTip : null;

// Error type definitions
const errorConfig = {
    400: {
        title: req.t('errors.statuses.400.title'),
        message: req.t('errors.statuses.400.message'),
        tip: req.t('errors.statuses.400.tip'),
        gradient: 'from-orange-600 to-orange-700'
    },
    401: {
        title: req.t('errors.statuses.401.title'),
        message: req.t('errors.statuses.401.message'),
        tip: req.t('errors.statuses.401.tip'),
        gradient: 'from-amber-600 to-amber-700'
    },
    403: {
        title: req.t('errors.statuses.403.title'),
        message: req.t('errors.statuses.403.message'),
        tip: req.t('errors.statuses.403.tip'),
        gradient: 'from-red-600 to-red-700'
    },
    404: {
        title: req.t('errors.statuses.404.title'),
        message: req.t('errors.statuses.404.message'),
        tip: req.t('errors.statuses.404.tip'),
        gradient: 'from-blue-600 to-blue-700'
    },
    500: {
        title: req.t('errors.statuses.500.title'),
        message: req.t('errors.statuses.500.message'),
        tip: req.t('errors.statuses.500.tip'),
        gradient: 'from-rose-700 to-rose-800'
    },
    503: {
        title: req.t('errors.statuses.503.title'),
        message: req.t('errors.statuses.503.message'),
        tip: req.t('errors.statuses.503.tip'),
        gradient: 'from-purple-600 to-purple-700'
    }
};

// Select appropriate configuration or fallback
const finalConfig = errorConfig[ec] || {
    title: req.t('errors.statuses.default.title'),
    message: req.t('errors.statuses.default.message'),
    tip: req.t('errors.statuses.default.tip'),
    gradient: 'from-slate-700 to-slate-800'
};

const finalTitle = finalConfig.title;
const finalMessage = cm || finalConfig.message;
const finalTip = ct || finalConfig.tip;
const finalGradient = finalConfig.gradient;
%>

<%- include("partials/header", { pageTitle: finalTitle + " - " + req.t('errors.titles.error') }) %>

<section class="relative min-h-[calc(100vh-200px)] flex items-center justify-center p-4 sm:p-6 lg:p-8 bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950">
    <div class="w-full max-w-2xl text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm mb-8 animate-fadeInDown">
            <span class="flex h-2 w-2 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
            </span>
            <span class="text-xs font-semibold text-slate-600 dark:text-slate-300 tracking-wider uppercase">
                <%= req.t('errors.labels.error_code') %> <%= ec %>
            </span>
        </div>

        <h1 class="status-code text-7xl sm:text-9xl font-black bg-gradient-to-r <%= finalGradient %> bg-clip-text text-transparent tracking-tighter mb-4 animate-pulse">
            <%= ec %>
        </h1>

        <h2 class="text-2xl sm:text-4xl font-bold text-slate-900 dark:text-white tracking-tight mb-8">
            <%= finalTitle %>
        </h2>

        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6 sm:p-8 shadow-sm dark:shadow-slate-950 text-left mb-8 max-w-xl mx-auto">
            <div class="space-y-6">
                <div>
                    <h3 class="text-xs font-bold text-slate-400 dark:text-slate-500 tracking-wider uppercase mb-2">
                        <%= req.t('errors.labels.what_happened') %>
                    </h3>
                    <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
                        <%= finalMessage %>
                    </p>
                </div>

                <div class="border-t border-slate-100 dark:border-slate-700/50"></div>

                <div>
                    <h3 class="text-xs font-bold text-slate-400 dark:text-slate-500 tracking-wider uppercase mb-2">
                        <%= req.t('errors.labels.suggested_tip') %>
                    </h3>
                    <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed flex gap-2">
                        <span><%= finalTip %></span>
                    </p>
                </div>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row justify-center gap-4 max-w-md mx-auto">
            <a href="/" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-blue-500/50 transition-all duration-300 w-full sm:w-auto">
                <i class="mdi mdi-home-outline text-lg"></i>
                <span><%= req.t('errors.labels.btn_home') %></span>
            </a>
            
            <div class="contents">
                <a href="/login" class="inline-flex items-center justify-center gap-2 px-6 py-3 border-2 border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 font-semibold rounded-lg hover:border-slate-400 dark:hover:border-slate-500 hover:bg-slate-50 dark:hover:bg-slate-700 transition-all duration-300 w-full sm:w-auto">
                    <i class="mdi mdi-login-variant text-lg"></i>
                    <span><%= req.t('errors.labels.btn_login') %></span>
                </a>
            </div>
        </div>

        <div class="mt-16 flex justify-center gap-8 text-slate-200 dark:text-slate-700 text-6xl opacity-20 dark:opacity-10">
            <i class="mdi <% // finalIcon %> animate-bounce" style="animation-delay: 0s"></i>
            <i class="mdi <% // finalIcon %> animate-bounce" style="animation-delay: 0.2s"></i>
            <i class="mdi <% // finalIcon %> animate-bounce" style="animation-delay: 0.4s"></i>
        </div>
    </div>
</section>

<script src="/dist/src/frontend/main.js"></script>

<style>
    @keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fadeInDown {
        animation: fadeInDown 0.6s ease-out;
    }

    @keyframes pulse {
        0%, 100% {
            opacity: 1;
        }
        50% {
            opacity: 0.7;
        }
    }

    .animate-pulse {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
</style>
<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

<%- include("partials/footer") %>