<%- include("../partials/header"), { title: blog.title } %>
<link id="prism-code-block" rel="stylesheet" href="/dist/node_modules/prismjs/themes/prism.css">
<link href="/css/blog.css" rel="stylesheet">

<%

function isURL(str) {
    try {
        new URL(str);
        return true;
    } catch (_) {
        return false;
    }
}

%>

<section id="blog-header" data-blog-id="<%= blog.blogid %>" data-blog-slug="<%= blog.title.toLowerCase().replace(/\s+/g, "-") %>" class="relative pt-20 sm:pt-24 pb-12 sm:pb-16 px-4 sm:px-6 lg:px-8 dark:w-[calc(100%+2rem)] dark:-translate-x-4 dark:sm:w-[calc(100%+3rem)] dark:sm:-translate-x-6 dark:lg:w-[calc(100%+4rem)] dark:lg:-translate-x-8 bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 dark:from-slate-950 dark:via-slate-900 dark:to-slate-900">
    <div class="mx-auto max-w-4xl">
        <div class="animate-fadeInDown">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 dark:text-white mb-4 leading-tight">
                <%= blog.title %>
            </h1>
            <div class="flex items-center gap-3 text-sm text-slate-600 dark:text-slate-400 mb-6">
                <span><i class="mdi mdi-calendar text-base"></i> <%= new Date(blog.createdAt || Date.now()).toLocaleDateString() %></span>
                <span><i class="mdi mdi-heart text-base"></i> <%= blog.likes || 0 %> likes</span>
            </div>
        </div>
    </div>
    <div class="flex flex-col gap-4 mx-auto max-w-4xl mt-8 border-t border-slate-200 dark:border-slate-700 pt-6">
        <div class="text-slate-700 dark:text-slate-300 leading-relaxed text-base sm:text-lg prose prose-sm sm:prose dark:prose-invert max-w-none">
            <i><%= blog.description %></i>
        </div>
        <!-- Author Section -->
        <% if(blog.author) { %>
            <div class="flex justify-end items-center gap-4">
                <div class="flex-1 text-right">
                    <p class="text-slate-900 dark:text-white font-semibold">
                        <button id="open-bio" class="min-h-auto" title="Click to see author bio">
                            <i class="mdi mdi-information-outline"></i>
                        </button>
                        Author
                    </p>
                    <p class="text-slate-600 dark:text-slate-400 text-sm">
                        <a href="/people/<%= blog.author.username %>" class="hover:text-blue-600 transition-colors duration-300">
                            <%= blog.author.display_name || blog.author.username %>
                        </a>
                    </p>
                </div>
                <% if(blog.author.avatar && isURL(blog.author.avatar)) { %>
                    <img class="w-10 h-10 rounded-full bg-white " referrerpolicy="no-referrer" src="<%= blog.author.avatar %>" alt="<%= blog.author.username %>">
                <% } else { %>
                    <div class="w-10 h-10 rounded-full bg-gradient-to-br <%= blog.author.avatar || 'from-blue-400 to-blue-600' %> flex items-center justify-center text-white font-bold text-lg">
                        <%= (blog.author.display_name || blog.author.username).charAt(0).toUpperCase() %>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
</section>

<div class="ql-container ql-snow mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <article class="ql-editor bg-white dark:text-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 sm:p-10 shadow-sm dark:shadow-slate-950 prose prose-sm sm:prose dark:prose-invert max-w-none">
        <%- blog.content %>
    </article>
    
    <div class="mt-10 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 sm:p-8">
        <div id="like-save-section">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Enjoyed this blog?</h3>
            <div class="relative flex items-center">
                <% if(!user) { %>
                    <p class="absolute w-full top-1/2 -translate-y-1/2 right-1/2 translate-x-1/2 text-center text-slate-700 dark:text-slate-300">Sign in to like and save this blog</p>
                <% } else { %>
                    <div class="btn-group flex items-center gap-3">
                        <button class="like-btn cursor-pointer flex items-center gap-2 px-4 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50 dark:hover:bg-slate-700 rounded-lg transition-all duration-300" data-id="<%= blog.blogid %>">
                            <i class="mdi mdi-heart text-lg"></i>
                            <span id="likes-count-<%= blog.blogid %>"><%= blog.likes || 0 %></span>
                        </button>
                        <button class="save-post cursor-pointer flex items-center gap-2 px-4 py-2 text-sm font-medium <%= user?.saved_blogs?.includes(blog.blogid) ? 'text-blue-600 dark:text-blue-400' : 'text-slate-600 dark:text-slate-400' %> hover:text-amber-600 dark:hover:text-amber-400 hover:bg-amber-50 dark:hover:bg-slate-700 rounded-lg transition-all duration-300" data-id="<%= blog.blogid %>" title="Save this blog to read later">
                            <i class="mdi mdi-bookmark text-lg"></i>
                            <span><%= user?.saved_blogs?.includes(blog.blogid) ? "Saved" : "Save" %></span>
                        </button>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    
    <!-- Comments Section -->
    <div class="mt-10 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 sm:p-8 overflow-x-auto">
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
            <i class="mdi mdi-comment-multiple"></i>Comments (<%= cc %>)
        </h3>
        
        <!-- Comment Input -->
        <% if(blog.allowComments === false || ap.default_allow_post_comments === false) { %>
            <div class="mb-8 pb-8 border-b border-slate-200">
                <p class="no-comment not-allowed text-center dark:text-slate-400 text-slate-700">Comments are disabled for this blog</p>
            </div>
        <% } else if(user) { %>
            <div class="mb-8 pb-8 border-b border-slate-200">
                <div class="flex gap-4">
                    <% if(isURL(user?.avatar)) { %>
                        <img class="w-10 h-10 rounded-full bg-white " referrerpolicy="no-referrer" src="<%= user?.avatar %>" alt="User Avatar">
                    <% } else { %>
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br <%= user?.avatar %> flex items-center justify-center text-white font-bold">
                            <%= user?.username.charAt(0).toUpperCase() || "U" %>
                        </div>
                    <% } %>
                    <div class="flex-1">
                        <textarea placeholder="Share your thoughts..." id="comment-content" class="dark:border-slate-600 dark:focus:border-blue-400 dark:focus:ring-blue-900 dark:bg-slate-900 dark:text-white dark:placeholder-slate-500 w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 focus:outline-none transition-all duration-300 bg-white text-slate-900 placeholder-slate-400 resize-none" rows="3"></textarea>
                        <div class="flex gap-3 mt-3 justify-end">
                            <button id="cancel-comment" class="dark:text-slate-200 dark:hover:bg-slate-700 px-4 py-2 text-slate-700 font-medium rounded-lg hover:bg-slate-100 transition-all duration-300">
                                Cancel
                            </button>
                            <button id="post-comment" class="px-6 py-2 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-blue-500/50 transition-all duration-300">
                                Post Comment
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div class="mb-8 pb-8 border-b border-slate-200">
                <p class="text-center text-slate-700 dark:text-slate-400">Sign in to leave comments on this blog</p>
            </div>
        <% } %>
        
        <!-- Comments List -->
        <div id="comments-list" class="space-y-6 min-w-[350px]">
            <% if(cap.length === 0) { %>
                <p class="no-comment text-center dark:text-slate-400 text-slate-700">This blog has no comments</p>
            <% } else { %>
                <% cap.forEach((one_cap) => { %>
                    <%- include("../partials/comment", { ocap: one_cap }) %>
                <% }) %>
            <% } %>
        </div>
        
        <!-- Load More Comments -->
        <% if(cap.length >= 3) { %>
            <div class="mt-6 text-center">
                <button id="load-comments-btn" class="text-blue-600 font-semibold hover:text-blue-700 transition-colors duration-300 flex items-center justify-center gap-2 mx-auto">
                    <i class="mdi mdi-chevron-down"></i>Load More Comments
                </button>
            </div>
        <% } %>
    </div>
    
    <div class="mt-8">
        <a href="/" class="inline-block px-6 py-3 text-blue-600 font-semibold hover:text-blue-700 transition-colors duration-300 flex items-center gap-2">
            <i class="mdi mdi-arrow-left"></i> Back to feed
        </a>
    </div>
</div>

<!-- Author Bio Modal -->
<div id="bio-modal" class="hidden fixed inset-0 top-[4.5rem] h-[calc(100%-4.5rem)] bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="flex flex-col h-[96%] bg-white dark:bg-slate-800 rounded-2xl shadow-2xl max-w-sm sm:max-w-md lg:max-w-lg w-full animate-fadeInDown">
        <!-- Modal Header with Close Button -->
        <div class="flex justify-between items-center px-6 py-4 border-b border-slate-200 dark:border-slate-600">
            <h2 class="text-3xl font-bold text-slate-900 dark:text-white">About Author</h2>
            <button id="close-bio-modal" class="font-size-auto text-slate-400 dark:text-slate-600 hover:text-slate-600 dark:hover:text-slate-400 text-2xl transition-colors">
                <i class="mdi mdi-close"></i>
            </button>
        </div>

        <!-- Modal Content -->
        <div class="flex-1 flex flex-col p-6 gap-4 overflow-auto">
            <!-- Author Avatar -->
            <div class="flex flex-row gap-4">
                <% if(blog.author.avatar && isURL(blog.author.avatar)) { %>
                    <img class="w-10 h-10 sm:w-12 sm:h-12 rounded-full border-2 sm:border-4 bg-white border-blue-100 shadow-md" referrerpolicy="no-referrer" src="<%= blog.author.avatar %>" alt="<%= blog.author.username %>">
                <% } else { %>
                    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-gradient-to-br <%= blog.author.avatar || 'from-blue-400 to-indigo-600' %> flex items-center justify-center text-white font-bold text-5xl border-2 sm:border-4 border-blue-100 shadow-md">
                        <%= (blog.author.display_name || blog.author.username).charAt(0).toUpperCase() %>
                    </div>
                <% } %>
                <div class="text-left">
                    <!-- Author Name -->
                    <h3 class="font-bold text-slate-900 dark:text-white mb-1">
                        <%= blog.author.display_name || blog.author.username %>
                    </h3>
        
                    <!-- Author Username -->
                    <p class="text-slate-600 dark:text-slate-400 text-xs mb-1">
                        <span class="font-semibold">@<%= blog.author.username %></span>
                    </p>
                </div>
            </div>

            <!-- Bio Section -->
            <div class="bio-content text-left flex-1 bg-slate-100 dark:bg-slate-900 rounded-lg p-4 overflow-auto">
                <% if(blog.author.bio) { %>
                    <p class="text-slate-700 dark:text-slate-300 leading-relaxed text-base">
                        <%= blog.author.bio %>
                    </p>
                <% } else { %>
                    <p class="h-full flex items-center justify-center text-slate-500 dark:text-slate-400 italic">This author hasn't added a bio yet.</p>
                <% } %>
            </div>

            <!-- View Profile Button -->
            <a href="/people/@<%= blog.author.username %>" class="text-center inline-block w-full px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-blue-500/50 transition-all duration-300">
                View Full Profile
            </a>
        </div>
    </div>
</div>

<%- include("../partials/footer") %>
