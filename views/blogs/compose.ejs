                    <button type="button" id="image-insert" class="flex-1 px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg">
                        <%= req.t("compose_actions.buttons.insert") %>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="link-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg dark:shadow-slate-950 max-w-md sm:max-w-lg w-full p-6">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-4"><%= req.t("compose_actions.titles.insert_link") %></h3>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"><%= req.t("compose_actions.labels.link_text") %></label>
                    <input type="text" id="link-text" class="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500" placeholder="<%= req.t("compose_actions.placeholders.link_text_placeholder") %>">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"><%= req.t("compose_actions.labels.url") %></label>
                    <input type="url" id="link-url" class="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500" placeholder="<%= req.t("compose_actions.placeholders.url_placeholder") %>">
