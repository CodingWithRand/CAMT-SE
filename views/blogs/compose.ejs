<%- include("../partials/header", { pageTitle: "Write Your Story - Whiskey" }) %>

<% const m = typeof mode !== 'undefined' ? mode : null; %>
<% ap = ap[0]; %>

<link rel="stylesheet" href="/css/compose.css">

<section class="relative pt-20 sm:pt-24 pb-16 sm:pb-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950">
    <div class="mx-auto max-w-4xl">
        <div class="text-center mb-12 sm:mb-16 animate-fadeInDown">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold bg-gradient-to-r from-slate-900 via-blue-800 to-slate-900 dark:from-white dark:via-blue-300 dark:to-white bg-clip-text text-transparent mb-6 leading-tight flex items-center justify-center gap-3">
                <i class="mdi size-var mdi-pencil text-4xl sm:text-5xl lg:text-6xl"></i><%= req.t("compose_actions.titles.write_your_story") %>
            </h1>
            <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
                <%= req.t("compose_actions.descriptions.subtitle") %>
            </p>
        </div>
    </div>
</section>

<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <form id="blog-composing-form" class="space-y-6" action="/api/compose" method="post">
        <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 sm:p-8 shadow-sm dark:shadow-slate-950">
            <div class="mb-6">
                <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-3"><%= req.t("compose_actions.labels.blog_title") %></label>
                <input 
                    class="w-full px-4 py-3 text-lg rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-900 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500" 
                    name="blogTitle" 
                    id="title" 
                    type="text" 
                    placeholder="<%= req.t("compose_actions.placeholders.title_placeholder") %>"
                    value="<%= m === 'edit' ? blogData.title : '' %>"
                    required
                >
            </div>
            
            <div class="mb-6">
                <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-3"><%= req.t("compose_actions.labels.blog_description") %></label>
                <textarea 
                    class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-900 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 resize-none" 
                    name="blogDescription"
                    id="description"
                    rows="3" 
                    placeholder="<%= req.t("compose_actions.placeholders.description_placeholder") %>"
                ><%= m === 'edit' ? blogData.description : '' %></textarea>
            </div>

            <div class="mb-3">
                <label class="block text-sm font-semibold text-slate-900 dark:text-white"><%= req.t("compose_actions.labels.your_story") %></label>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1"><%= req.t("compose_actions.descriptions.toolbar_tip") %></p>
            </div>

            <div id="editor-toolbar" class="bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-t-lg p-3 flex flex-wrap gap-2 items-center border-b-0">
                <div class="flex gap-1 border-r border-slate-300 dark:border-slate-600 pr-2">
                    <button type="button" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" data-format="bold" title="<%= req.t("compose_actions.tooltips.bold") %>">
                        <i class="mdi mdi-format-bold"></i>
                    </button>
                    <button type="button" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" data-format="italic" title="<%= req.t("compose_actions.tooltips.italic") %>">
                        <i class="mdi mdi-format-italic"></i>
                    </button>
                    <button type="button" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" data-format="underline" title="<%= req.t("compose_actions.tooltips.underline") %>">
                        <i class="mdi mdi-format-underline"></i>
                    </button>
                    <button type="button" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" data-format="strike" title="<%= req.t("compose_actions.tooltips.strikethrough") %>">
                        <i class="mdi mdi-format-strikethrough"></i>
                    </button>
                </div>

                <div class="flex gap-1 border-r border-slate-300 dark:border-slate-600 pr-2">
                    <div class="relative group">
                        <button type="button" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" id="text-color-btn" title="<%= req.t("compose_actions.tooltips.text_color") %>">
                            <i class="mdi mdi-format-color-text"></i>
                        </button>
                        <div id="text-color-picker" class="hidden absolute top-10 left-0 bg-white dark:bg-slate-800 rounded-lg shadow-lg border border-slate-200 dark:border-slate-700 p-3 z-50 w-56">
                            <p class="text-xs font-semibold text-slate-600 dark:text-slate-300 mb-2"><%= req.t("compose_actions.tooltips.preset_colors") %></p>
                            <div class="grid grid-cols-6 gap-2 mb-3">
                                <button type="button" class="color-option w-8 h-8 rounded hover:ring-2 ring-slate-400 transition" style="background-color: #1e293b;" data-color="#1e293b"></button>
                                <button type="button" class="color-option w-8 h-8 rounded hover:ring-2 ring-slate-400 transition" style="background-color: #3b82f6;" data-color="#3b82f6"></button>
                                <button type="button" class="color-option w-8 h-8 rounded hover:ring-2 ring-slate-400 transition" style="background-color: #ef4444;" data-color="#ef4444"></button>
                                <button type="button" class="color-option w-8 h-8 rounded hover:ring-2 ring-slate-400 transition" style="background-color: #10b981;" data-color="#10b981"></button>
                                <button type="button" class="color-option w-8 h-8 rounded hover:ring-2 ring-slate-400 transition" style="background-color: #f59e0b;" data-color="#f59e0b"></button>
                                <button type="button" class="color-option w-8 h-8 rounded hover:ring-2 ring-slate-400 transition" style="background-color: #8b5cf6;" data-color="#8b5cf6"></button>
                            </div>
                            <div class="flex gap-2 items-center">
                                <label class="text-xs font-semibold text-slate-600 dark:text-slate-300"><%= req.t("compose_actions.tooltips.custom") %></label>
                                <input type="color" id="text-color-input" class="w-12 h-8 rounded cursor-pointer border border-slate-200 dark:border-slate-600" value="#1e293b">
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-2"><%= req.t("compose_actions.tooltips.recently_used") %></p>
                            <div class="flex gap-2 mt-2" id="recent-text-colors"></div>
                        </div>
                    </div>
                    
                    <div class="relative group">
                        <button type="button" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" id="text-highlight-btn" title="<%= req.t("compose_actions.tooltips.text_highlight") %>">
                            <i class="mdi mdi-format-color-highlight"></i>
                        </button>
                        <div id="text-highlight-picker" class="hidden absolute top-10 left-0 bg-white dark:bg-slate-800 rounded-lg shadow-lg border border-slate-200 dark:border-slate-700 p-3 z-50 w-56">
                            <p class="text-xs font-semibold text-slate-600 dark:text-slate-300 mb-2"><%= req.t("compose_actions.tooltips.preset_colors") %></p>
                            <div class="grid grid-cols-6 gap-2 mb-3">
                                <button type="button" class="highlight-option w-8 h-8 rounded hover:ring-2 ring-slate-400 transition border border-slate-300" style="background-color: #fef08a;" data-color="#fef08a"></button>
                                <button type="button" class="highlight-option w-8 h-8 rounded hover:ring-2 ring-slate-400 transition border border-slate-300" style="background-color: #fecaca;" data-color="#fecaca"></button>
                                <button type="button" class="highlight-option w-8 h-8 rounded hover:ring-2 ring-slate-400 transition border border-slate-300" style="background-color: #bfdbfe;" data-color="#bfdbfe"></button>
                                <button type="button" class="highlight-option w-8 h-8 rounded hover:ring-2 ring-slate-400 transition border border-slate-300" style="background-color: #a7f3d0;" data-color="#a7f3d0"></button>
                                <button type="button" class="highlight-option w-8 h-8 rounded hover:ring-2 ring-slate-400 transition border border-slate-300" style="background-color: #ddd6fe;" data-color="#ddd6fe"></button>
                                <button type="button" class="highlight-option w-8 h-8 rounded hover:ring-2 ring-slate-400 transition border border-slate-300" style="background-color: #f3e8ff;" data-color="#f3e8ff"></button>
                            </div>
                            <div class="flex gap-2 items-center">
                                <label class="text-xs font-semibold text-slate-600 dark:text-slate-300"><%= req.t("compose_actions.tooltips.custom") %></label>
                                <input type="color" id="text-highlight-input" class="w-12 h-8 rounded cursor-pointer border border-slate-200 dark:border-slate-600" value="#fef08a">
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-2"><%= req.t("compose_actions.tooltips.recently_used") %></p>
                            <div class="flex gap-2 mt-2" id="recent-highlight-colors"></div>
                        </div>
                    </div>
                    
                    <button type="button" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" id="clear-format-btn" title="<%= req.t("compose_actions.tooltips.clear_formatting") %>">
                        <i class="mdi mdi-format-clear"></i>
                    </button>
                </div>

                <div class="flex gap-1 border-r border-slate-300 dark:border-slate-600 pr-2">
                    <button type="button" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" data-format="align" data-value="" title="<%= req.t("compose_actions.tooltips.align_left") %>">
                        <i class="mdi mdi-format-align-left"></i>
                    </button>
                    <button type="button" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" data-format="align" data-value="center" title="<%= req.t("compose_actions.tooltips.align_center") %>">
                        <i class="mdi mdi-format-align-center"></i>
                    </button>
                    <button type="button" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" data-format="align" data-value="right" title="<%= req.t("compose_actions.tooltips.align_right") %>">
                        <i class="mdi mdi-format-align-right"></i>
                    </button>
                    <button type="button" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" data-format="align" data-value="justify" title="<%= req.t("compose_actions.tooltips.justify") %>">
                        <i class="mdi mdi-format-align-justify"></i>
                    </button>
                </div>

                <div class="flex gap-1 border-r border-slate-300 dark:border-slate-600 pr-2">
                    <select class="w-36 toolbar-select px-3 py-2 rounded border border-slate-300 dark:border-slate-600 hover:bg-slate-100 dark:hover:bg-slate-700 transition text-sm bg-white dark:bg-slate-900 text-slate-900 dark:text-white" data-format="header" title="<%= req.t("compose_actions.tooltips.heading") %>">
                        <option value=""><%= req.t("compose_actions.options.normal") %></option>
                        <option value="1"><%= req.t("compose_actions.options.heading_1") %></option>
                        <option value="2"><%= req.t("compose_actions.options.heading_2") %></option>
                        <option value="3"><%= req.t("compose_actions.options.heading_3") %></option>
                    </select>
                </div>

                <div class="flex gap-1 border-r border-slate-300 dark:border-slate-600 pr-2">
                    <button type="button" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" data-format="list" data-value="ordered" title="<%= req.t("compose_actions.tooltips.ordered_list") %>">
                        <i class="mdi mdi-format-list-numbered"></i>
                    </button>
                    <button type="button" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" data-format="list" data-value="bullet" title="<%= req.t("compose_actions.tooltips.bullet_list") %>">
                        <i class="mdi mdi-format-list-bulleted"></i>
                    </button>
                    <button type="button" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" data-format="blockquote" title="<%= req.t("compose_actions.tooltips.quote") %>">
                        <i class="mdi mdi-format-quote-open"></i>
                    </button>
                    <button type="button" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" data-format="code-block" title="<%= req.t("compose_actions.tooltips.code_block") %>">
                        <span class="mdi mdi-xml"></span>
                    </button>
                </div>

                <div class="flex gap-1">
                    <button type="button" id="insert-image-btn" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" title="<%= req.t("compose_actions.tooltips.insert_image") %>">
                        <i class="mdi mdi-image-plus"></i>
                    </button>
                    <button type="button" id="insert-link-btn" class="toolbar-btn p-2 rounded hover:bg-slate-200 dark:hover:bg-slate-700 transition" title="<%= req.t("compose_actions.tooltips.insert_link") %>">
                        <i class="mdi mdi-link-plus"></i>
                    </button>
                </div>
            </div>

            <div id="editor" data-mode="<%= m ?? 'compose' %>" data-editing-content="<%= m === 'edit' ? JSON.stringify(blogData.content) : '' %>" class="w-full rounded-b-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus-within:ring-2 focus-within:ring-blue-200 dark:focus-within:ring-blue-900 bg-white dark:bg-slate-900 text-slate-900 dark:text-white" style="min-height: 300px;"></div>
            
            <input type="hidden" id="content" name="blogBody" required>

            <p class="flex items-center gap-1 text-xs text-slate-500 dark:text-slate-400 mt-3"><i class="mdi mdi-lightbulb"></i> <%= req.t("compose_actions.descriptions.lightbulb_tip") %></p>
        </div>
        
        <div class="flex flex-col gap-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 sm:p-8 shadow-sm dark:shadow-slate-950">
            <div>
                <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-3"><%= req.t("compose_actions.labels.blog_visibility") %></label>
                <select 
                    id="visibility" 
                    name="visibility" 
                    class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-900 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white"
                >
                    <option value="2" <%= m === 'edit' && blogData.visibility === 2 ? 'selected' : '' %>><%= req.t("compose_actions.options.public") %></option>
                    <option value="1" <%= m === 'edit' && blogData.visibility === 1 ? 'selected' : '' %>><%= req.t("compose_actions.options.unlisted") %></option>
                    <option value="0" <%= m === 'edit' && blogData.visibility === 0 ? 'selected' : '' %>><%= req.t("compose_actions.options.private") %></option>
                </select>
                <ul class="text-xs text-slate-500 dark:text-slate-400 mt-2">
                    <li><span class="font-semibold"><%= req.t("compose_actions.options.public") %>:</span> <%= req.t("compose_actions.descriptions.public_desc") %></li>
                    <li><span class="font-semibold"><%= req.t("compose_actions.options.unlisted") %>:</span> <%= req.t("compose_actions.descriptions.unlisted_desc") %></li>
                    <li><span class="font-semibold"><%= req.t("compose_actions.options.private") %>:</span> <%= req.t("compose_actions.descriptions.private_desc") %></li>
                </ul>
            </div>
            <div class="flex items-center justify-between gap-6">
                <div class="flex items-center gap-3">
                    <label class="font-semibold text-sm text-slate-900 dark:text-white transition-all duration-300"><%= req.t("compose_actions.labels.allow_comments") %></label>
                <% if (ap && ap.default_allow_post_comments === false) { %>
                    <p class="text-xs text-red-600 dark:text-red-400"><%= req.t("compose_actions.descriptions.disable_comments_warning") %><a href="/account/preferences" class="text-blue-600 dark:text-blue-400 hover:underline"><%= req.t("compose_actions.descriptions.preferences_link_text") %></a>.</p>
                </div>
                <% } else { %>
                    <p class="text-xs text-slate-500 dark:text-slate-400 transition-all duration-300"><%= req.t("compose_actions.descriptions.set_comments_desc") %></p>
                </div>
                <input type="checkbox" name="allow-comments" class="<%= ap && ap.default_allow_post_comments === false ? 'hidden' : '' %> w-5 h-5 text-blue-600 rounded" <%= m === 'edit' && blogData.allow_comments ? 'checked' : m === 'edit' && !blogData.allow_comments ? '' : 'checked' %> />
                <% } %>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-between">
            <a href="/" class="px-6 py-3 border-2 border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-semibold rounded-lg hover:border-slate-400 dark:hover:border-slate-500 dark:hover:bg-slate-700 transition-all duration-300 text-center">
                <%= req.t("compose_actions.buttons.cancel") %>
            </a>
            <button type="submit" class="px-8 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-blue-500/50 transition-all duration-300 flex justify-center items-center gap-2" id="publish">
                <i class="mdi mdi-upload"></i><%= m === 'edit' ? req.t("compose_actions.buttons.update_blog") : req.t("compose_actions.buttons.publish_blog") %>
            </button>
        </div>
    </form>
    
    <div class="mt-12 bg-blue-50 dark:bg-slate-800 border border-blue-200 dark:border-slate-700 rounded-xl p-6 sm:p-8">
        <h3 class="font-semibold text-slate-900 dark:text-white mb-3 flex items-center gap-2"><i class="mdi mdi-note-text"></i><%= req.t("compose_actions.titles.tips_header") %></h3>
        <ul class="space-y-2 text-slate-600 dark:text-slate-300 text-sm">
            <li class="flex items-center gap-2"><i class="mdi mdi-check text-green-600 dark:text-green-400"></i><%= req.t("compose_actions.tips_list.0") %></li>
            <li class="flex items-center gap-2"><i class="mdi mdi-check text-green-600 dark:text-green-400"></i><%= req.t("compose_actions.tips_list.1") %></li>
            <li class="flex items-center gap-2"><i class="mdi mdi-check text-green-600 dark:text-green-400"></i><%= req.t("compose_actions.tips_list.2") %></li>
            <li class="flex items-center gap-2"><i class="mdi mdi-check text-green-600 dark:text-green-400"></i><%= req.t("compose_actions.tips_list.3") %></li>
            <li class="flex items-center gap-2"><i class="mdi mdi-check text-green-600 dark:text-green-400"></i><%= req.t("compose_actions.tips_list.4") %></li>
            <li class="flex items-center gap-2"><i class="mdi mdi-check text-green-600 dark:text-green-400"></i><%= req.t("compose_actions.tips_list.5") %></li>
        </ul>
    </div>

    <div id="image-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg dark:shadow-slate-950 max-w-md sm:max-w-lg w-full p-6">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-4"><%= req.t("compose_actions.titles.insert_image") %></h3>
            <div class="space-y-4">
                <div class="flex gap-2 border-b border-slate-200 dark:border-slate-700">
                    <button type="button" id="image-tab-url" class="px-4 py-2 border-b-2 border-blue-500 text-blue-600 dark:text-blue-400 font-medium transition"><%= req.t("compose_actions.buttons.url_tab") %></button>
                    <button type="button" id="image-tab-upload" class="px-4 py-2 border-b-2 border-transparent text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 font-medium transition"><%= req.t("compose_actions.buttons.upload_tab") %></button>
                </div>

                <div id="image-url-tab" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"><%= req.t("compose_actions.labels.image_url") %></label>
                        <input type="text" id="image-url" class="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500" placeholder="<%= req.t("compose_actions.placeholders.image_url_placeholder") %>">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"><%= req.t("compose_actions.labels.alt_text") %></label>
                        <input type="text" id="image-alt" class="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500" placeholder="<%= req.t("compose_actions.placeholders.describe_image_placeholder") %>">
                    </div>
                </div>

                <div id="image-upload-tab" class="hidden space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"><%= req.t("compose_actions.labels.select_image_file") %></label>
                        <div class="border-2 border-dashed border-slate-300 dark:border-slate-600 rounded-lg p-3 text-center hover:border-blue-500 dark:hover:border-blue-400 hover:bg-blue-50 dark:hover:bg-slate-700 transition cursor-pointer" id="image-drop-zone">
                            <div class="flex flex-row gap-4 flex-wrap mb-2" id="previews"></div>
                            <i class="mdi mdi-cloud-upload text-4xl text-slate-400 dark:text-slate-500 mb-2 px-3"></i>
                            <p class="text-sm text-slate-600 dark:text-slate-400 px-3"><%= req.t("compose_actions.descriptions.drag_drop") %></p>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 px-3 pb-3"><%= req.t("compose_actions.descriptions.click_select") %></p>
                            <input type="file" id="image-file-input" class="hidden" accept="image/*">
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"><%= req.t("compose_actions.labels.alt_text") %></label>
