<%- include("../partials/header", { pageTitle: null }) %>

<link rel="stylesheet" href="/css/home.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tektur:wght@400..900&display=swap" rel="stylesheet">

<section class="relative -mt-0 dark:mb-8 pt-20 sm:pt-24 pb-16 sm:pb-20 dark:w-[calc(100%+2rem)] dark:-translate-x-4 dark:sm:w-[calc(100%+3rem)] dark:sm:-translate-x-6 dark:lg:w-[calc(100%+4rem)] dark:lg:-translate-x-8 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 dark:from-slate-800 dark:via-slate-900 dark:to-slate-800">
    <div class="mx-auto max-w-4xl relative z-[1]">
        <div class="text-center mb-12 sm:mb-16 animate-fadeInDown">
            <div class="inline-block mb-4 px-3 py-1 rounded-full text-xs font-semibold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-700 flex items-center gap-1">
                <i class="mdi mdi-creation"></i> <%= req.t('landing.badge') %>
            </div>
            
            <h1 id="inviting-text" class="relative min-h-12 lg:min-h-20 text-4xl sm:text-5xl lg:text-6xl font-bold bg-gradient-to-r from-slate-900 via-blue-800 to-slate-900 dark:from-white dark:via-blue-300 dark:to-white bg-clip-text text-transparent mb-4 sm:mb-6 leading-tight">
                
            </h1>
            
            <p class="text-base sm:text-lg lg:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed mb-8 sm:mb-10 px-2">
                <%= req.t('landing.description_p1') %>
                <%= req.t('landing.description_p2') %>
            </p>
            
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
                <a href="/compose" class="group w-full sm:w-auto px-8 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-blue-500/50 hover:scale-105 transition-all duration-300 flex items-center justify-center gap-2">
                    <i class="mdi mdi-pencil"></i><%= req.t('landing.btn_write') %>
                </a>
                <a href="/login" class="w-full sm:w-auto px-8 py-3 border-2 border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 font-semibold rounded-lg hover:border-blue-500 dark:hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50 dark:hover:bg-slate-900 transition-all duration-300 flex items-center justify-center gap-2">
                    <i class="mdi mdi-book-open"></i><%= req.t('landing.btn_explore') %>
                </a>
            </div>
        </div>
    </div>
    <img src="./imgs/coworking-team-indoors-cartoon-characters.png" style="mask-image: linear-gradient(black 0%, rgba(0,0,0,0.5) 50%, black 100%)" class="absolute w-full h-full top-0 left-0 object-cover opacity-30 dark:opacity-10">
</section>

<div class="dark:mb-8 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20 dark:bg-slate-950">
    
    <% if((featuredPosts && featuredPosts.length > 0) && (latestPosts && latestPosts.length > 0)) { %>
        
        <section id="posts" class="mb-16 sm:mb-24">
            <div class="mb-10 sm:mb-12">
                <div class="flex justify-center items-center gap-3 mb-2">
                    <div class="h-3 w-8 sm:w-12 bg-gradient-to-r from-blue-400 to-indigo-500 rounded-full mt-2"></div>
                    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 dark:text-white"><%= req.t('landing.popular_title') %></h2>
                    <div class="h-3 w-8 sm:w-12 bg-gradient-to-r from-indigo-500 to-blue-400 rounded-full mt-2"></div>
                </div>
                <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base ml-2 text-center"><%= req.t('landing.popular_subtitle_p1') %>
                <%= req.t('landing.popular_subtitle_p2') %></p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
                <% featuredPosts.slice(0, 6).forEach((post, index) => {%>
                    <%- include("../partials/saves/postcard-v1", { post, index, cc: commentCounts.fp[index] }) %>
                <% }) %>
            </div>
        </section>

        <section class="mb-16 sm:mb-24">

            <div class="mb-10 sm:mb-12">
                <div class="flex justify-center items-center gap-3 mb-2">
                    <div class="h-3 w-3 bg-gradient-to-r from-indigo-400 to-blue-400 dark:from-indigo-300 dark:to-blue-300 rounded-full mt-2"></div>
                    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 dark:text-white"><%= req.t('landing.latest_title') %></h2>
                    <div class="h-3 w-3 bg-gradient-to-r from-indigo-400 to-blue-400 dark:from-indigo-300 dark:to-blue-300 rounded-full mt-2"></div>
                </div>
                <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base ml-2 text-center"><%= req.t('landing.latest_subtitle') %></p>
            </div>
            
            <div class="space-y-3 sm:space-y-4">
                <% const maxCC = Math.max(...commentCounts.lp) %>
                <% latestPosts.slice(0, 6).forEach((post, index) => {%>
                    <%- include("../partials/saves/postcard-v3", { post, index, cc: commentCounts.lp[index], maxCC }) %>
                <% }) %>
            </div>
        </section>

    <% } else { %>
        <section class="text-center py-16 sm:py-24">
            <div class="text-6xl sm:text-8xl mb-4 sm:mb-6">📝</div>
            <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white mb-2"><%= req.t('landing.empty_title') %></h3>
            <p class="text-slate-600 dark:text-slate-400 mb-6 sm:mb-8 text-base sm:text-lg"><%= req.t('landing.empty_desc') %></p>
            <a href="/compose" class="inline-block px-6 sm:px-8 py-2.5 sm:py-3 bg-blue-500 text-white font-semibold rounded-lg hover:bg-blue-600 transition-colors duration-300">
                <%= req.t('landing.empty_cta') %>
            </a>
        </section>
    <% } %>
</div>

<section class="bg-gradient-to-r from-slate-900 to-blue-800 dark:from-slate-800 dark:via-slate-900 dark:to-slate-800 text-white py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
        <h3 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-4"><%= req.t('landing.cta_box_title') %></h3>
        <p class="text-blue-100 mb-6 sm:mb-8 max-w-2xl mx-auto text-base sm:text-lg leading-relaxed px-2">
            <%= req.t('landing.cta_box_desc_p1') %>
            <%= req.t('landing.cta_box_desc_p2') %>
        </p>
        <a href="/compose" class="inline-block px-8 py-3 bg-white text-blue-600 font-semibold rounded-lg hover:bg-blue-50 transition-all duration-300 hover:shadow-lg">
            <%= req.t('landing.cta_box_btn') %>
        </a>
    </div>
</section>

<%- include("../partials/footer") %>

<div id="loading-overlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-100 hidden">
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-2xl p-8 text-center">
        <div class="inline-block mb-4">
            <div class="relative w-12 h-12">
                <div class="absolute inset-0 bg-gradient-to-r from-blue-400 to-indigo-600 rounded-full animate-spin" style="animation-duration: 1.5s;"></div>
                <div class="absolute inset-1 bg-white dark:bg-slate-800 rounded-full"></div>
            </div>
        </div>
        <p class="text-slate-700 dark:text-slate-200 font-semibold text-lg"><%= req.t('landing.redirecting') %></p>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-2"><%= req.t('landing.auth_wait') %></p>
    </div>
</div>

<div id="open-scene" class="transition-all w-screen h-screen bg-neutral-900 fixed z-100 p-8">
    <div id="branding-text-meaning" class="transition-all duration-1000 origin-top-left w-full h-full flex flex-col gap-4 justify-evenly items-center">
        <p style="width: 3.25rem;" class="w-full text-slate-200 text-5xl sm:text-6xl transition-all duration-500 opacity-0 min-h-12 sm:min-h-14 h-15 overflow-x-hidden overflow-y-clip"><b class="text-white">W</b>isdom</p>
        <p style="width: 2.5rem;" class="w-full text-slate-200 text-5xl sm:text-6xl transition-all duration-500 opacity-0 min-h-12 sm:min-h-14 h-15 overflow-x-hidden overflow-y-clip"><b class="text-white">H</b>umanity</p>
        <p style="width: 1.75rem;" class="overlapped w-full text-slate-200 text-5xl sm:text-6xl transition-all duration-500 opacity-0 min-h-12 sm:min-h-14 h-15 -translate-y-40 overflow-x-hidden overflow-y-clip"><b class="text-white">I</b>nsight</p>
        <p style="width: 2.5rem;" class="w-full text-slate-200 text-5xl sm:text-6xl transition-all duration-500 opacity-0 min-h-12 sm:min-h-14 h-15 overflow-x-hidden overflow-y-clip"><b class="text-white">S</b>tory</p>
        <p style="width: 2.5rem;" class="overlapped w-full text-slate-200 text-5xl sm:text-6xl transition-all duration-500 opacity-0 min-h-12 sm:min-h-14 h-15 -translate-y-80 overflow-x-hidden overflow-y-clip"><b class="text-white">K</b>nowledge</p>
        <p style="width: 2.25rem;" class="w-full text-slate-200 text-5xl sm:text-6xl transition-all duration-500 opacity-0 min-h-12 sm:min-h-14 h-15 overflow-x-hidden overflow-y-clip"><b class="text-white">E</b>xperience</p>
        <p style="width: 2.5rem;" class="dropped w-full text-slate-200 text-5xl sm:text-6xl transition-all duration-500 opacity-0 min-h-14 h-15 overflow-x-hidden overflow-y-clip"><b class="text-white">Y...</b></p>
    </div>
    <div id="scene-play" class="transition-all duration-4000 phone-adjusted absolute w-screen h-screen top-0 left-0">
        <img id="book" class="transition-all duration-1000" style="bottom: -100vh" src="./imgs/open-cutscene/book.png">
        <img id="gp1" class="transition-all duration-1000" src="./imgs/open-cutscene/3.png">
        <img id="gp2" class="transition-all duration-1000" src="./imgs/open-cutscene/4.png">
        <img id="gp3" class="transition-all duration-1000" src="./imgs/open-cutscene/5.png">
        <img id="gp4" class="transition-all duration-1000" src="./imgs/open-cutscene/6.png">
        <img id="book-pile" class="transition-all duration-1000" src="./imgs/open-cutscene/7.png">
    </div>
</div>

