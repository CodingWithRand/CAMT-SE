<%- include("partials/header", { pageTitle: authType === 'password-reset' ? req.t('auth_flows.titles.reset') : authType === 'email-verification' ? req.t('auth_flows.titles.verify') : authType === '2fa' ? req.t('auth_flows.titles.tfa') : req.t('auth_flows.titles.default') }) %>

<% const isInvalid = authType === 'password-reset' || authType === 'email-verification' || authType === '2fa'; %>

<div id="invalid-request-modal" class="<%= isInvalid ? 'hidden' : '' %> fixed inset-0 top-[4.5rem] h-[calc(100%-4.5rem)] bg-black/50 flex items-center justify-center px-4 z-50 animate-fadeIn">
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-8 shadow-lg dark:shadow-slate-950 w-full max-w-md">
        <div class="text-center mb-6">
            <h2 class="text-2xl font-bold text-red-600 dark:text-red-400 mb-2"><%= req.t('auth_flows.invalid.title') %></h2>
            <p class="text-slate-600 dark:text-slate-400"><%= req.t('auth_flows.invalid.desc') %></p>
        </div>

        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 rounded-lg p-4 mb-6 text-center">
            <p id="error-message" class="text-red-700 dark:text-red-400 text-sm font-medium"><%= req.t('auth_flows.invalid.msg') %></p>
        </div>

        <div class="flex flex-col gap-3">
            <a href="/login" class="w-full px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-blue-500/50 transition-all duration-300 text-center">
                <%= req.t('auth_flows.invalid.btn_login') %>
            </a>
           
            <a href="/" class="w-full px-6 py-3 border-2 border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 font-semibold rounded-lg hover:border-slate-400 dark:hover:border-slate-500 hover:bg-slate-50 dark:hover:bg-slate-700 transition-all duration-300 text-center">
                <%= req.t('auth_flows.invalid.btn_home') %>
            </a>
        </div>
    </div>
</div>

<section id="auth-action" class="relative min-h-[calc(100vh-200px)] flex items-center justify-center p-4 sm:p-6 lg:p-8 bg-gradient-to-b from-slate-50 via-blue-50 to-indigo-50 dark:from-slate-800 dark:via-slate-900 dark:to-slate-800">
    <div class="w-full">
        <div class="w-full max-w-md sm:max-w-lg mx-auto">
      
            <% if (authType === 'password-reset') { %>
            <div class="text-center mb-10 animate-fadeInDown">
                <h1 class="p-2 text-4xl sm:text-6xl font-bold bg-gradient-to-r from-slate-900 via-blue-800 to-slate-900 dark:from-white dark:via-blue-300 dark:to-white bg-clip-text text-transparent mb-3">
                    <%= req.t('auth_flows.reset_pwd.title') %>
                </h1>
                <p class="text-slate-600 dark:text-slate-400"><%= req.t('auth_flows.reset_pwd.desc') %></p>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm mb-6">
    
                <form id="password-reset-form" class="space-y-5">
                    <div>
                        <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2"><%= req.t('auth_flows.reset_pwd.label_new') %></label>
                        <input 
                            type="password" 
                            name="new-password"
                            id="new-password"
                            placeholder="<%= req.t('auth_flows.reset_pwd.placeholder_new') %>" 
                            class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500"
                            required
                        />
                    </div>

                    <div class="bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-lg p-4 space-y-2">
                        <p class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-3"><%= req.t('auth_flows.reset_pwd.requirements_title') %></p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <div class="flex items-center gap-2 text-xs">
                                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-300 dark:bg-red-700 text-red-600 dark:text-red-200" id="length-icon">✗</span>
                                <span id="length-text" class="text-red-600 dark:text-red-400"><%= req.t('auth_flows.reset_pwd.req_length') %></span>
                            </div>
   
                            <div class="flex items-center gap-2 text-xs">
                                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-300 dark:bg-red-700 text-red-600 dark:text-red-200" id="uppercase-icon">✗</span>
                                <span id="uppercase-text" class="text-red-600 dark:text-red-400"><%= req.t('auth_flows.reset_pwd.req_uppercase') %></span>
                            </div>
                            <div class="flex items-center gap-2 text-xs">
                                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-300 dark:bg-red-700 text-red-600 dark:text-red-200" id="number-icon">✗</span>
                                <span id="number-text" class="text-red-600 dark:text-red-400"><%= req.t('auth_flows.reset_pwd.req_number') %></span>
                            </div>
                        
                            <div class="flex items-center gap-2 text-xs">
                                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-300 dark:bg-red-700 text-red-600 dark:text-red-200" id="special-icon">✗</span>
                                <span id="special-text" class="text-red-600 dark:text-red-400"><%= req.t('auth_flows.reset_pwd.req_special') %></span>
                            </div>
                        </div>
                    </div>   

                    <div>
                        <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2"><%= req.t('auth_flows.reset_pwd.label_confirm') %></label>
                        <input 
                            type="password" 
                            name="confirm-password"
                            id="confirm-password"
                            placeholder="<%= req.t('auth_flows.reset_pwd.placeholder_confirm') %>" 
                            class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500"
                            required
                        />
                    </div>

                    <button type="submit" class="w-full px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-blue-500/50 transition-all duration-300">
                        <%= req.t('auth_flows.reset_pwd.btn_submit') %>
                    </button>
                </form>

                <div id="reset-success-message" class="hidden mt-6 p-4 bg-green-50 border border-green-200 rounded-lg text-center">
                    <p class="text-green-700 font-semibold"><%= req.t('auth_flows.reset_pwd.success_title') %></p>
                    <p class="text-green-600 text-sm mt-1"><%= req.t('auth_flows.reset_pwd.success_desc') %></p>
                </div>
            </div>

            <p class="text-center text-slate-600">
                <%= req.t('auth_flows.reset_pwd.remember_pwd') %>
                <a href="/login" class="text-blue-600 font-semibold hover:text-blue-700"><%= req.t('auth_flows.reset_pwd.signin_here') %></a>
            </p>

        <% } else if (authType === 'email-verification') { %>
            <div class="text-center mb-10 animate-fadeInDown">
                <h1 class="p-2 text-3xl sm:text-4xl font-bold bg-gradient-to-r from-slate-900 via-blue-800 to-slate-900 bg-clip-text text-transparent mb-3">
                    <%= req.t('auth_flows.email_verify.title') %>
                </h1>
                <p class="text-slate-600"><%= req.t('auth_flows.email_verify.desc') %></p>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm mb-6">
                <form id="email-verification-form" class="space-y-5">
                    <div>
                        <label class="block text-sm font-semibold text-slate-900 mb-2"><%= req.t('auth_flows.email_verify.label_code') %></label>
                        <input 
                            type="text" 
                            name="verificationCode"
                            id="verification-code"
                            placeholder="<%= req.t('auth_flows.email_verify.placeholder_code') %>" 
                            maxlength="6"
                            class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-blue-500 focus:outline-none transition-all duration-300 bg-white text-slate-900 placeholder-slate-400 text-center tracking-widest font-mono text-lg"
                            required
                        />
                        <p class="err-msg text-xs text-slate-500 mt-2"><%= req.t('auth_flows.email_verify.hint') %></p>
                    </div>

                    <button type="submit" class="w-full px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-blue-500/50 transition-all duration-300">
                        <%= req.t('auth_flows.email_verify.btn_submit') %>
                    </button>

                    <button type="button" id="resend-code-btn" class="w-full px-6 py-3 border-2 border-slate-300 text-slate-700 font-semibold rounded-lg hover:border-slate-400 hover:bg-slate-50 transition-all duration-300">
                        <%= req.t('auth_flows.email_verify.btn_resend') %>
                    </button>
                </form>

                <div id="verify-success-message" class="hidden mt-6 p-4 bg-green-50 border border-green-200 rounded-lg text-center">
                    <p class="text-green-700 font-semibold"><%= req.t('auth_flows.email_verify.success_title') %></p>
                    <p class="text-green-600 text-sm mt-1"><%= req.t('auth_flows.email_verify.success_desc') %></p>
                </div>
            </div>

            <p class="text-center text-slate-600">
                <%= req.t('auth_flows.email_verify.already_verified') %>
                <a href="/login" class="text-blue-600 font-semibold hover:text-blue-700"><%= req.t('auth_flows.email_verify.go_to_login') %></a>
            </p>

        <% } else if (authType === '2fa') { %>
            <div class="text-center mb-10 animate-fadeInDown">
                <h1 class="text-3xl sm:text-4xl font-bold bg-gradient-to-r from-slate-900 via-blue-800 to-slate-900 bg-clip-text text-transparent mb-3">
                    <%= req.t('auth_flows.tfa_flow.title') %>
                </h1>
                <p class="text-slate-600"><%= req.t('auth_flows.tfa_flow.desc') %></p>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm mb-6">
                <form id="two-factor-form" class="space-y-5">
                    <div>
                        <label class="block text-sm font-semibold text-slate-900 mb-2"><%= req.t('auth_flows.tfa_flow.label_code') %></label>
                        <input 
                            type="text" 
                            name="totpCode"
                            id="totp-code"
                            placeholder="<%= req.t('auth_flows.tfa_flow.placeholder_code') %>" 
                            maxlength="6"
                            class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-blue-500 focus:outline-none transition-all duration-300 bg-white text-slate-900 placeholder-slate-400 text-center tracking-widest font-mono text-lg"
                            required
                        />
                        <p class="err-msg text-xs text-slate-500 mt-2"><%= req.t('auth_flows.tfa_flow.hint') %></p>
                    </div>

                    <button type="submit" class="w-full px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-blue-500/50 transition-all duration-300">
                        <%= req.t('auth_flows.tfa_flow.btn_submit') %>
                    </button>
                </form>

                <div id="2fa-success-message" class="hidden mt-6 p-4 bg-green-50 border border-green-200 rounded-lg text-center">
                    <p class="text-green-700 font-semibold"><%= req.t('auth_flows.tfa_flow.success_title') %></p>
                    <p class="text-green-600 text-sm mt-1"><%= req.t('auth_flows.tfa_flow.success_desc') %></p>
                </div>
            </div>

            <p class="text-center text-slate-600">
                <%= req.t('auth_flows.tfa_flow.no_code') %> 
                <a href="#" class="text-blue-600 font-semibold hover:text-blue-700"><%= req.t('auth_flows.tfa_flow.backup_link') %></a>
            </p>
        <% } %>
        </div>
    </div>
</section>

<%- include("partials/footer") %>