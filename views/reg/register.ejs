<%- include("../partials/header", { pageTitle: "Sign Up - Whiskey" }) %>

<section class="relative min-h-[calc(100vh-200px)] flex items-center justify-center p-4 sm:p-6 lg:p-8 bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 dark:from-slate-800 dark:via-slate-900 dark:to-slate-800">
    <div class="w-full max-w-md sm:max-w-lg">
        <!-- Welcome Message -->
        <div class="text-center mb-10 animate-fadeInDown">
            <h1 class="p-2 text-4xl sm:text-6xl font-bold bg-gradient-to-r from-slate-900 via-blue-800 to-slate-900 dark:from-white dark:via-blue-300 dark:to-white bg-clip-text text-transparent mb-3">
                <%= req.t('auth.register.title') %>
            </h1>
            <p class="text-slate-600 dark:text-slate-400"><%= req.t('auth.register.subtitle') %></p>
        </div>

        <!-- Register Form Card -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-8 shadow-sm dark:shadow-slate-950 mb-6">
            <form id="register-form" class="space-y-5" action="/api/register/email" method="post">
                <!-- Full Name Field -->
                <div>
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2"><%= req.t('auth.register.username_label') %></label>
                    <input 
                        type="text" 
                        name="userName" 
                        placeholder="<%= req.t('auth.register.username_placeholder') %>" 
                        class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500"
                    />
                </div>

                <!-- Email Field -->
                <div>
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2"><%= req.t('auth.register.email_label') %></label>
                    <input 
                        type="email" 
                        name="email" 
                        placeholder="<%= req.t('auth.register.email_placeholder') %>" 
                        class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500"
                    />
                </div>

                <!-- Password Field -->
                <div>
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2"><%= req.t('auth.register.password_label') %></label>
                    <input 
                        type="password" 
                        name="password" 
                        placeholder="<%= req.t('auth.register.password_placeholder') %>" 
                        class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500"
                    />
                </div>

                <div class="bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 rounded-lg p-4 space-y-2">
                    <p class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-3"><%= req.t('auth.register.password_requirements') %></p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <div class="flex items-center gap-2 text-xs">
                            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-300 dark:bg-red-700 text-red-600 dark:text-red-200" id="length-icon">✗</span>
                                <span id="length-text" class="text-red-600 dark:text-red-400"><%= req.t('auth.register.password_min_length') %></span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-300 dark:bg-red-700 text-red-600 dark:text-red-200" id="uppercase-icon">✗</span>
                            <span id="uppercase-text" class="text-red-600 dark:text-red-400"><%= req.t('auth.register.password_uppercase') %></span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-300 dark:bg-red-700 text-red-600 dark:text-red-200" id="number-icon">✗</span>
                            <span id="number-text" class="text-red-600 dark:text-red-400"><%= req.t('auth.register.password_number') %></span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-300 dark:bg-red-700 text-red-600 dark:text-red-200" id="special-icon">✗</span>
                            <span id="special-text" class="text-red-600 dark:text-red-400"><%= req.t('auth.register.password_special') %></span>
                        </div>
                    </div>
                </div>

                <!-- Confirm Password Field -->
                <div>
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2"><%= req.t('auth.register.confirm_password_label') %></label>
                    <input 
                        type="password" 
                        name="confirmPassword" 
                        placeholder="<%= req.t('auth.register.confirm_password_placeholder') %>" 
                        class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 focus:border-blue-500 dark:focus:border-blue-400 focus:outline-none transition-all duration-300 bg-white dark:bg-slate-900 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500"
                    />
                </div>

                <!-- Terms Agreement -->
                <label class="flex items-start gap-3 cursor-pointer">
                    <input type="checkbox" class="w-5 h-5 mt-0.5 rounded border-slate-300 dark:border-slate-600" />
                    <span class="text-sm text-slate-600 dark:text-slate-400">
                        <%= req.t('auth.register.terms_agreement') %> <a href="#" class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300"><%= req.t('auth.register.terms_of_service') %></a> & <a href="#" class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300"><%= req.t('auth.register.privacy_policy') %></a>
                    </span>
                </label>
                <!-- Sign Up Button -->
                <button type="submit" class="w-full px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-blue-500/50 transition-all duration-300">
                    <%= req.t('auth.register.create_account') %>
                </button>
            </form>

            <!-- Divider -->
            <div class="relative my-6">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-slate-300 dark:border-slate-600"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="px-2 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400"><%= req.t('auth.register.or_signup_with') %></span>
                </div>
            </div>

            <!-- OAuth Button -->
            <button id="sign-up-w-google" type="button" class="w-full flex items-center justify-center gap-3 px-6 py-3 border-2 border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 font-semibold rounded-lg hover:border-slate-400 dark:hover:border-slate-500 hover:bg-slate-50 dark:hover:bg-slate-700 transition-all duration-300">
                <i class="mdi mdi-google text-xl"></i>
                <%= req.t('auth.register.signup_google') %>
            </button>
        </div>

        <!-- Sign In Link -->
        <p class="text-center text-slate-600 dark:text-slate-400">
            <%= req.t('auth.register.have_account') %> 
            <a href="/login" class="text-blue-600 dark:text-blue-400 font-semibold hover:text-blue-700 dark:hover:text-blue-300"><%= req.t('auth.register.signin_here') %></a>
        </p>
    </div>
    <!-- <script src="/js/register.js" type="module"></script> -->
</section>

<%- include("../partials/footer") %>

<style>
    @keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fadeInDown {
        animation: fadeInDown 0.6s ease-out;
    }
</style>
