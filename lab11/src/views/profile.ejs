
<!DOCTYPE html>
<html>
<head>
    <title>Profile</title>
    <meta charset="utf-8" />
    <style>
        body { font-family: Arial, sans-serif; margin:0; padding:0; background:#fafafa; color:#333; }
        a { color:#336699; text-decoration:none; }
        nav { background:#eef2f5; padding:10px 20px; display:flex; justify-content:space-between; align-items:center; }
        nav span { line-height:1.5; }
        #error { color:#c33; text-align:center; margin:10px; }
        .container { padding:20px; max-width:500px; margin:40px auto; background:#fff; border-radius:8px; box-shadow:0 2px 5px rgba(0,0,0,0.1); }
        h1 { text-align:center; }
        button { background:#336699; color:#fff; border:none; padding:10px 14px; cursor:pointer; border-radius:4px; }
        button:hover { background:#285a8f; }
    </style>
</head>
<body>
    <nav>
        <span><strong>My App</strong></span>
        <span style="float:right">
            <% if (user) { %>
                Logged in as <%= user.email %> | <a href="/logout">Logout</a>
            <% } else { %>
                <a href="/login">Login</a>
            <% } %>
        </span>
    </nav>
    
    <div class="container">
        <h1>Profile (Protected)</h1>
        <p>UserId: <%= user.userId %></p>
        <p>Email: <%= user.email %></p>
        <form method="POST" action="/logout">
            <button type="submit">Logout</button>
        </form>
    </div>
</body>
</html>